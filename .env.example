# Razvojne vrednosti. Kopirati u .env (bez izmena radi odmah): cp .env.example .env
# Pravi .env je van repozitorijuma (u .gitignore).

POSTGRES_DB=race_direction
POSTGRES_USER=race
POSTGRES_PASSWORD=race_dev_password
POSTGRES_PORT=5432

SERVER_PORT=8080

# Tajna kojom server potpisuje prijavu (token). Samo razvojna vrednost.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Koliko minuta važi prijava, podešava se na serveru.
SESSION_MINUTES=60

# Ključ spoljnog servisa (u KT2 je servis lažan). Poziva ga samo server.
PENALTY_API_KEY=dev-fake-key
